# The EUDIPLO the issuer suite is validated against (issuer harness design section 5.5, decision 2): a digest of the
# main image until a release has what the catalogue tests (README). Read by `docker compose --env-file` and by
# src/reference.ts; change it here only.
EUDIPLO_IMAGE=ghcr.io/eudiplo/eudiplo@sha256:1a1f53b77b69cfeaf573f6950de6a70947b909181654a6de252f8207e1b138a7
EUDIPLO_EXPECT_VERSION=9.1.0-main.ae0792a
EUDIPLO_REVISION=ae0792a98991c28607879c2291d26b26b9ee9817
